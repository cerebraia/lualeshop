# =============================================
# Luale Kids Shop — Variables de entorno
# =============================================
# Copia este archivo como .env.local y completa los valores.
# NO subas .env.local al repositorio.

# ─── Data provider ────────────────────────────────────────────────────────────
# "mock"     → localStorage + datos mock (sin Supabase, funciona offline)
# "supabase" → Supabase PostgreSQL + Auth + Storage
NEXT_PUBLIC_DATA_PROVIDER=supabase

# ─── Supabase (requerido cuando DATA_PROVIDER=supabase) ──────────────────────
# Obtener en: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Solo servidor (NUNCA exponer al navegador) ───────────────────────────────
# Usado únicamente en Server Actions, Route Handlers o scripts de migración.
# No anteponer NEXT_PUBLIC_ a esta variable.
SUPABASE_SERVICE_ROLE_KEY=

# ─── SEO / Indexación ────────────────────────────────────────────────────────
# false → noindex (durante staging/validación)
# true  → permitir indexación pública (SOLO activar tras auditoría completa)
NEXT_PUBLIC_ALLOW_INDEXING=false

# ─── Configuración general ────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=584220162748
